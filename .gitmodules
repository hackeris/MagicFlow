# Rust 扩展源码 submodule —— 由 scripts/build_rust_exts.sh 从源码交叉编译
# tokenizers.abi3.so / _safetensors_rust.abi3.so（OHOS aarch64，产物 sha256 与 prebuilt 锚比对）。
# 注意:两个仓库均为官方 huggingface 仓库的固定 commit（非浮点 HEAD）:
#   tokenizers  = 7f1623b  "Bump version to 0.23.1"
#   safetensors = a406ca3  "fix(release): move crates.io to trusted publisher OIDC"
[submodule "thirdparty/tokenizers"]
	path = thirdparty/tokenizers
	url = https://github.com/huggingface/tokenizers.git
[submodule "thirdparty/safetensors"]
	path = thirdparty/safetensors
	url = https://github.com/huggingface/safetensors.git
# 前端源码 —— 自维护 fork 化(docs/frontend-fork-plan.md): hackeris/ComfyUI_frontend,
#   默认分支 ohos(= 定制线, 基线 = 官方稳定 tag v1.54.4(8d24aed)); 官方 source 同步:
#   git fetch upstream tag → ohos rebase; 本地 push 该仓库需 -c core.hooksPath=/dev/null
#   (husky pre-push 在 node22 壳下崩, 钩子只 lint, 推官方 commit 无必要)。
#   构建链: scripts/build_frontend.sh → thirdparty/comfyui-frontend/dist → stage 前端注入。
[submodule "thirdparty/comfyui-frontend"]
	path = thirdparty/comfyui-frontend
	url = git@github.com:hackeris/ComfyUI_frontend.git
	branch = ohos
