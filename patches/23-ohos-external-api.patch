+// OHOS_EXTERNAL_API v1 — 云 API 密钥设置项 + 本地/云双模路由提示
+// 设计: docs/external-api-node-design.md §1.5
+//
+// 密钥为什么用「自定义渲染器」而不是普通 text 设置项:
+//   普通设置项的值会落进 comfy.settings.json(明文); 自定义渲染器不调 setter,
+//   值只经 /api/ohos/apikeys 写进 <comfyui根>/api_keys.json(0600),
+//   且界面只回显掩码 —— 两处都不留明文。
+import { app } from "../../scripts/app.js";
+import { api } from "../../scripts/api.js";
+
+const API_PATH = "/ohos/apikeys"; // api.fetchApi 自动补 /api 前缀
+
+const PROVIDERS = {
+  siliconflow: { label: "硅基流动", url: "https://cloud.siliconflow.cn/account/ak" },
+  dashscope: { label: "阿里百炼", url: "https://bailian.console.aliyun.com/?apiKey=1" },
+};
+
+// 本机实测上限(status-and-next.md §2): 512 级在任何模型形态下都 SIG9
+const DEVICE_MAX_SIZE = 256;
+
+const INPUT_CSS =
+  "flex:1;min-width:0;padding:4px 8px;border:1px solid var(--border-color,#666);" +
+  "border-radius:4px;background:transparent;color:inherit";
+const BUTTON_CSS =
+  "padding:4px 12px;border:1px solid var(--border-color,#666);border-radius:4px;" +
+  "background:transparent;color:inherit;cursor:pointer;white-space:nowrap";
+
+function keyRenderer(provider) {
+  return (name, setter, value, attrs) => {
+    const row = document.createElement("div");
+    row.style.cssText = "display:flex;gap:8px;align-items:center;width:100%";
+
+    const input = document.createElement("input");
+    input.type = "password";
+    input.style.cssText = INPUT_CSS;
+
+    const save = document.createElement("button");
+    save.textContent = "保存";
+    save.style.cssText = BUTTON_CSS;
+
+    const status = document.createElement("span");
+    status.style.cssText = "font-size:12px;opacity:.8;white-space:nowrap";
+
+    const refresh = async () => {
+      try {
+        const r = await api.fetchApi(API_PATH);
+        const info = (await r.json())?.keys?.[provider];
+        input.placeholder = info?.configured ? info.masked : "未配置";
+      } catch {
+        input.placeholder = "未配置"; // 后端未就绪时静默
+      }
+    };
+
+    save.onclick = async () => {
+      const key = input.value.trim();
+      if (!key) {
+        status.textContent = "请先输入密钥";
+        return;
+      }
+      save.disabled = true;
+      status.textContent = "保存中…";
+      try {
+        const r = await api.fetchApi(API_PATH, {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ provider, key }),
+        });
+        const d = await r.json().catch(() => ({}));
+        if (!r.ok) throw new Error(d?.error?.message || `HTTP ${r.status}`);
+        input.value = "";
+        input.placeholder = d.masked || "已配置";
+        status.textContent = "已保存";
+      } catch (e) {
+        status.textContent = `失败: ${e.message}`;
+      } finally {
+        save.disabled = false;
+      }
+    };
+
+    row.append(input, save, status);
+    refresh();
+    return row;
+  };
+}
+
+// ── 本地/云双模路由: 判定「本地跑不动」 ──────────────────────────────────────
+// 只做静态判定(读工作流结构), 不试跑 —— 依据两条, 都能从图里直接读出来。
+function localInfeasibility() {
+  const reasons = [];
+  for (const n of app.graph?._nodes || []) {
+    if (n.type === "EmptyLatentImage") {
+      const w = Number(n.widgets?.find((x) => x.name === "width")?.value || 0);
+      const h = Number(n.widgets?.find((x) => x.name === "height")?.value || 0);
+      if (w > DEVICE_MAX_SIZE || h > DEVICE_MAX_SIZE) {
+        reasons.push(`分辨率 ${w}×${h} 超过本机上限 ${DEVICE_MAX_SIZE}`);
+      }
+    }
+    const ckpt = n.widgets?.find((x) => x.name === "ckpt_name");
+    if (ckpt?.value) {
+      const options = n.constructor?.nodeData?.input?.required?.ckpt_name?.[0];
+      if (Array.isArray(options) && !options.includes(ckpt.value)) {
+        reasons.push(`模型 ${ckpt.value} 不在本机模型库`);
+      }
+    }
+  }
+  return [...new Set(reasons)];
+}
+
+function checkLocalFeasibility() {
+  const reasons = localInfeasibility();
+  if (!reasons.length) {
+    alert("本工作流在本机可以运行。");
+    return;
+  }
+  alert(
+    "本机跑不动这个工作流:\n\n" +
+      reasons.map((r) => `· ${r}`).join("\n") +
+      "\n\n可以用「云 API 生图」节点把这一步交给云端 API 执行。",
+  );
+}
+
+app.registerExtension({
+  name: "ohos.external_api",
+
+  settings: Object.entries(PROVIDERS).map(([id, meta]) => ({
+    id: `MagicFlow.ApiKey.${id}`,
+    name: `${meta.label} API 密钥`,
+    type: keyRenderer(id),
+    defaultValue: "",
+    tooltip: `密钥只存本机、不随工作流传出。获取地址: ${meta.url}`,
+  })),
+
+  getCanvasMenuOptions() {
+    return [{ content: "检查本机能否运行此工作流", callback: checkLocalFeasibility }];
+  },
+});
