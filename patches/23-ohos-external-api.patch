+# OHOS_EXTERNAL_API v1 — 自研通用第三方 API 节点组(W4; 设计 docs/external-api-node-design.md)
+"""三个节点: OHOS_API_Text / OHOS_API_Image / OHOS_API_HTTP。纯 Python, 零新依赖。
+
+输出标准 ComfyUI 类型(TEXT=STRING / IMAGE=torch 张量), 可直接接 PreviewImage / SaveImage
+等原生下游。密钥: 节点只填服务商名(provider), 真实密钥存 <comfyui根>/api_keys.json
+(由前端设置页经 /api/ohos/apikeys 写入) ⇒ **工作流 json 里没有秘密**。
+
+模板: headers/body 里的 {{name}} 会被替换为 JSON 字面量(字符串带引号, 数字原样),
+      可用占位符见 _template_values(); {{api_key}} 由 provider 自动解析。
+"""
+import json
+
+from .api_client import (ApiError, base64_to_image_tensor, extract_path,
+                         http_request, render_template, resolve_api_key,
+                         template_placeholders)
+
+CATEGORY = "ohos/api"
+
+_PROVIDERS = ["(none)", "siliconflow", "dashscope", "custom"]
+
+# 鉴权头用 {{auth_header}}(整值占位符, 由 _template_values 组装 "Bearer <key>")。
+# ⚠ 不能写 "Bearer {{api_key}}": 占位符在引号内时, render_template 的 JSON 字面量替换会
+#   产出 `"Bearer "sk-xxx""`(双引号嵌套, 非法 JSON) —— 即"配了密钥反而必炸"。
+#   本项目铁律: **占位符只能作独立 JSON 值**(裸写), 嵌入字符串由 Python 侧拼好再传入。
+_HEADERS_DEFAULT = """{
+  "Content-Type": "application/json",
+  "Authorization": {{auth_header}}
+}"""
+
+# ⚠ 占位符作为**独立 JSON 值**时必须裸写(不带引号): render_template 会把它替换为 JSON
+#   字面量(字符串自带引号)。写成 "{{prompt}}" 会渲染出 ""..." "(双引号嵌套)非法 JSON ——
+#   2026-09-12 真机 mock 复现(content 变成 ""你好，云""), 打真实 API 必被 400。
+#   故默认模板用裸模板字符串, **不能**走 json.dumps(= 会给值加引号)。
+#   嵌入字符串内的占位符(如 "Bearer {{api_key}}"、"{{w}}x{{h}}")仍带引号, 见 _HEADERS_DEFAULT。
+_BODY_TEXT_DEFAULT = """{
+  "model": "Qwen/Qwen2.5-7B-Instruct",
+  "messages": [{"role": "user", "content": {{prompt}}}]
+}"""
+
+_BODY_IMAGE_DEFAULT = """{
+  "model": "Kwai-Kolors/Kolors",
+  "prompt": {{prompt}},
+  "image_size": "{{width}}x{{height}}"
+}"""
+
+
+def _template_values(provider, extra):
+    """组装占位符表。provider=(none) 时 api_key 置空串(允许无鉴权端点, 如本地模拟器);
+    配了 provider 却没密钥 → 报可读错误, 不让请求带着空鉴权发出去。"""
+    values = dict(extra)
+    if provider and provider != "(none)":
+        key = resolve_api_key(provider)
+        if not key:
+            raise ApiError(
+                f"服务商「{provider}」尚未配置密钥 —— 请在 设置 → 云 API 密钥 里填写")
+        values["api_key"] = key
+        values["auth_header"] = f"Bearer {key}"
+    else:
+        values["api_key"] = ""
+        values["auth_header"] = ""
+    return values
+
+
+def _render_checked(what, text, values):
+    """渲染模板并校验没有残留占位符(残留 = 用户拼错了名字, 应报错而非静默发请求)。"""
+    out = render_template(text, values)
+    left = template_placeholders(out)
+    if left:
+        raise ApiError(f"{what} 里有未填充的占位符: {', '.join(left)}")
+    return out
+
+
+def _loads(what, text, fallback=None):
+    try:
+        return json.loads(text) if text.strip() else (fallback if fallback is not None else {})
+    except ValueError as e:
+        raise ApiError(f"{what} 不是合法 JSON: {e}")
+
+
+class OHOS_API_Text:
+    """文本/LLM API(OpenAI 兼容 chat completions, 或任意返回 JSON 的文本端点)。"""
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {
+            "required": {
+                "url": ("STRING", {"default": "https://api.siliconflow.cn/v1/chat/completions"}),
+                "provider": (_PROVIDERS,),
+                "headers": ("STRING", {"default": _HEADERS_DEFAULT, "multiline": True}),
+                "body": ("STRING", {"default": _BODY_TEXT_DEFAULT, "multiline": True}),
+                "path": ("STRING", {"default": "choices[0].message.content"}),
+                "timeout": ("INT", {"default": 60, "min": 1, "max": 600}),
+            },
+            "optional": {
+                "prompt": ("STRING", {"default": "", "multiline": True}),
+            },
+        }
+
+    RETURN_TYPES = ("STRING",)
+    RETURN_NAMES = ("TEXT",)
+    FUNCTION = "run"
+    CATEGORY = CATEGORY
+    # 无下游也可执行(空 TEXT 输出会被 validate_prompt 判为 prompt_no_outputs 拒收)
+    OUTPUT_NODE = True
+
+    def run(self, url, provider, headers, body, path, timeout, prompt=""):
+        values = _template_values(provider, {"prompt": prompt, "temperature": 0.7,
+                                             "seed": 0, "width": 1024, "height": 1024})
+        hdr = _loads("headers", _render_checked("headers", headers, values))
+        body_text = _render_checked("body", body, values)
+        raw = http_request("POST", url, headers=hdr, body=body_text.encode("utf-8"),
+                           timeout=timeout)
+        data = _loads("响应", raw.decode("utf-8", "replace"), fallback=None)
+        value = extract_path(data, path)
+        text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
+        return (text,)
+
+
+class OHOS_API_Image:
+    """图像生成/编辑 API(OpenAI 兼容 images/generations, 或任意返回 base64 图片的端点)。
+
+    输出标准 IMAGE 张量, 可直接接 PreviewImage / SaveImage / 其他原生图像节点。
+    """
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {
+            "required": {
+                "url": ("STRING", {"default": "https://api.siliconflow.cn/v1/images/generations"}),
+                "provider": (_PROVIDERS,),
+                "headers": ("STRING", {"default": _HEADERS_DEFAULT, "multiline": True}),
+                "body": ("STRING", {"default": _BODY_IMAGE_DEFAULT, "multiline": True}),
+                "field": ("STRING", {"default": "data[0].b64_json"}),
+                "timeout": ("INT", {"default": 120, "min": 1, "max": 600}),
+            },
+            "optional": {
+                "prompt": ("STRING", {"default": "", "multiline": True}),
+                "width": ("INT", {"default": 1024, "min": 64, "max": 4096}),
+                "height": ("INT", {"default": 1024, "min": 64, "max": 4096}),
+                "seed": ("INT", {"default": 0, "min": 0, "max": 0xffffffff}),
+            },
+        }
+
+    RETURN_TYPES = ("IMAGE",)
+    RETURN_NAMES = ("IMAGE",)
+    FUNCTION = "run"
+    CATEGORY = CATEGORY
+    OUTPUT_NODE = True
+
+    def run(self, url, provider, headers, body, field, timeout,
+            prompt="", width=1024, height=1024, seed=0):
+        values = _template_values(provider, {"prompt": prompt, "width": width,
+                                             "height": height, "seed": seed,
+                                             "temperature": 0.7})
+        hdr = _loads("headers", _render_checked("headers", headers, values))
+        body_text = _render_checked("body", body, values)
+        raw = http_request("POST", url, headers=hdr, body=body_text.encode("utf-8"),
+                           timeout=timeout)
+        data = _loads("响应", raw.decode("utf-8", "replace"), fallback=None)
+        return (base64_to_image_tensor(extract_path(data, field)),)
+
+
+class OHOS_API_HTTP:
+    """通用 HTTP 请求(任意 JSON API: 第三方网关 / 自建 hub / 代理服务)。
+
+    双输出: TEXT(响应原文) + JSON(格式化后; 解析失败时与 TEXT 相同)。
+    """
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {
+            "required": {
+                "method": (["GET", "POST", "PUT", "DELETE"],),
+                "url": ("STRING", {"default": "https://example.com/api"}),
+                "provider": (_PROVIDERS,),
+                "headers": ("STRING", {"default": _HEADERS_DEFAULT, "multiline": True}),
+                "body": ("STRING", {"default": "{}", "multiline": True}),
+                "timeout": ("INT", {"default": 30, "min": 1, "max": 600}),
+            },
+        }
+
+    RETURN_TYPES = ("STRING", "STRING")
+    RETURN_NAMES = ("TEXT", "JSON")
+    FUNCTION = "run"
+    CATEGORY = CATEGORY
+    OUTPUT_NODE = True
+
+    def run(self, method, url, provider, headers, body, timeout):
+        values = _template_values(provider, {"prompt": "", "seed": 0,
+                                             "width": 1024, "height": 1024,
+                                             "temperature": 0.7})
+        hdr = _loads("headers", _render_checked("headers", headers, values))
+        body_text = _render_checked("body", body, values) if method != "GET" else ""
+        raw = http_request(method, url, headers=hdr,
+                           body=body_text.encode("utf-8") if body_text else None,
+                           timeout=timeout)
+        text = raw.decode("utf-8", "replace")
+        try:
+            pretty = json.dumps(json.loads(text), ensure_ascii=False, indent=2)
+        except ValueError:
+            pretty = text
+        return (text, pretty)
+
+
+NODE_CLASS_MAPPINGS = {
+    "OHOS_API_Text": OHOS_API_Text,
+    "OHOS_API_Image": OHOS_API_Image,
+    "OHOS_API_HTTP": OHOS_API_HTTP,
+}
+
+NODE_DISPLAY_NAME_MAPPINGS = {
+    "OHOS_API_Text": "云 API 文本 (Text)",
+    "OHOS_API_Image": "云 API 生图 (Image)",
+    "OHOS_API_HTTP": "云 API 通用请求 (HTTP)",
+}
