+# OHOS_EXTERNAL_API v1 — 自研第三方 API 节点组的 HTTP 客户端
+# (设计: docs/external-api-node-design.md; 密钥方案见该文 §1.5)
+"""纯 requests 实现, 零新依赖(requests/PIL/numpy/torch 均在设备栈内)。
+
+分工: 本模块只管「发请求 / 解析响应 / 转张量」, 不含任何 ComfyUI 节点语义。
+密钥: 从 <comfyui根>/api_keys.json 读(与 server.py 的 /api/ohos/apikeys 端点同源);
+      节点参数只写服务商名 ⇒ 工作流 json 里不含秘密。
+"""
+import base64
+import io
+import json
+import os
+import re
+
+__all__ = [
+    "ApiError", "api_keys_path", "load_api_keys", "resolve_api_key",
+    "render_template", "template_placeholders", "extract_path",
+    "http_request", "base64_to_image_tensor",
+]
+
+
+class ApiError(Exception):
+    """节点级可读错误。nodes.py 捕获后直接冒泡(显示为节点错误, 不崩进程)。"""
+
+
+# ── 密钥 ────────────────────────────────────────────────────────────────────
+
+def comfy_root():
+    """comfyui 根目录。优先 folder_paths(对 zipimport 亦正确), 退化为本文件上溯三级。"""
+    try:
+        import folder_paths
+        return folder_paths.base_path
+    except Exception:
+        return os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+
+def api_keys_path():
+    return os.path.join(comfy_root(), "api_keys.json")
+
+
+def load_api_keys():
+    """读密钥表; 文件缺失/损坏一律返回空表(节点据此报「未配置」, 不抛裸异常)。"""
+    try:
+        with open(api_keys_path(), encoding="utf-8") as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def resolve_api_key(provider):
+    """未配置返回 None —— 调用方据此报可读错误, 而不是发出无鉴权的请求。"""
+    if not provider or provider == "(none)":
+        return None
+    return load_api_keys().get(provider) or None
+
+
+# ── 模板 ────────────────────────────────────────────────────────────────────
+
+_PLACEHOLDER = re.compile(r"\{\{\s*([A-Za-z_][A-Za-z0-9_]*)\s*\}\}")
+
+
+def template_placeholders(text):
+    return sorted({m.group(1) for m in _PLACEHOLDER.finditer(text or "")})
+
+
+def render_template(text, values):
+    """把 {{name}} 替换为 values[name] 的 JSON 字面量(字符串带引号, 数字/布尔原样)。
+
+    单层替换(不做二次展开): 替换结果里若含 {{...}} 不会被再次解释。
+    values 里没有的占位符原样保留 —— 由调用方比对 template_placeholders 报错,
+    避免静默发出缺字段的请求。
+    """
+    def repl(m):
+        key = m.group(1)
+        if key not in values:
+            return m.group(0)
+        return json.dumps(values[key], ensure_ascii=False)
+
+    return _PLACEHOLDER.sub(repl, text or "")
+
+
+# ── JSON 路径提取 ───────────────────────────────────────────────────────────
+
+_PATH_TOKEN = re.compile(r"([A-Za-z_][A-Za-z0-9_\-]*)|\[(\d+)\]")
+
+
+def extract_path(data, path):
+    """按 `a.b[0].c` 取值。path 为空 → 原样返回。取不到 → ApiError(指出断在哪一层)。"""
+    if not path:
+        return data
+    cur = data
+    for name, index in _PATH_TOKEN.findall(path):
+        where = f"[{index}]" if index != "" else name
+        try:
+            cur = cur[int(index)] if index != "" else cur[name]
+        except (KeyError, IndexError, TypeError):
+            raise ApiError(f"响应里找不到字段路径 '{path}'(在 {where} 处中断)")
+    return cur
+
+
+# ── HTTP ────────────────────────────────────────────────────────────────────
+
+DEFAULT_MAX_RESPONSE_BYTES = 20 * 1024 * 1024
+
+
+def http_request(method, url, headers=None, body=None, timeout=30,
+                 max_response_bytes=DEFAULT_MAX_RESPONSE_BYTES):
+    """发请求, 返回原始 bytes。失败抛 ApiError(含 HTTP 状态码 + body 前 200 字)。"""
+    import requests  # 延迟 import: 宿主纯逻辑单测无需此依赖
+
+    if not re.match(r"^https?://", url or "", re.I):
+        raise ApiError(f"URL 必须以 http/https 开头, 实际: {url!r}")
+    try:
+        resp = requests.request(method, url, headers=headers or {}, data=body,
+                                timeout=timeout, stream=True)
+    except requests.Timeout:
+        raise ApiError(f"请求超时({timeout}s): {url}")
+    except requests.RequestException as e:
+        raise ApiError(f"请求失败: {e}")
+
+    with resp:
+        raw = b""
+        for chunk in resp.iter_content(65536):
+            raw += chunk
+            if len(raw) > max_response_bytes:
+                raise ApiError(f"响应超过上限({max_response_bytes}B), 已中止: {url}")
+        if resp.status_code != 200:
+            snippet = raw[:200].decode("utf-8", "replace")
+            raise ApiError(f"HTTP {resp.status_code}: {snippet}")
+    return raw
+
+
+# ── base64 → IMAGE 张量 ─────────────────────────────────────────────────────
+
+def base64_to_image_tensor(text):
+    """base64 → torch 张量 (1,H,W,C) float32/255(与官方 bytesio_to_image_tensor 同构)。
+
+    延迟 import torch/PIL/numpy —— 宿主纯逻辑单测不装这些也能测本模块其余部分。
+    """
+    import numpy as np
+    import torch
+    from PIL import Image
+
+    if not text:
+        raise ApiError("响应里的图像字段为空")
+    try:
+        raw = base64.b64decode(text, validate=True)
+    except Exception as e:
+        raise ApiError(f"图像字段不是合法 base64: {e}")
+    try:
+        img = Image.open(io.BytesIO(raw)).convert("RGB")
+    except Exception as e:
+        raise ApiError(f"base64 内容不是可解码的图像: {e}")
+    arr = np.asarray(img).astype("float32") / 255.0
+    return torch.from_numpy(arr)[None, ...]
