+(nodes.py load_custom_node 目录分支 spec_from_file_location(__init__.py))。
+
+WEB_DIRECTORY 使 web/ 下的 JS 被前端自动加载(server.py 的 /extensions/<name> 静态路由 +
+/extensions 列表端点), 用于注册 API 密钥设置项与本地/云双模路由提示 —— 无需改前端 fork。
+"""
+from .nodes import (
+    NODE_CLASS_MAPPINGS,
+    NODE_DISPLAY_NAME_MAPPINGS,
+)
+
+WEB_DIRECTORY = "./web"
+
