+    {"id": "sd15", "name": "v1-5-pruned-emaonly.safetensors", "directory": "checkpoints",
+     "url": "https://huggingface.co/runwayml/stable-diffusion-v1-5/resolve/main/v1-5-pruned-emaonly.safetensors",
+     "size_bytes": 0, "tier": "optional",
+     "description": "SD1.5 完整权重(~4.3GB, 大/慢; 低内存设备建议仅 sd-turbo)"},
+    {"id": "realesrgan-x4plus", "name": "RealESRGAN_x4plus.pth", "directory": "upscale_models",
+     "url": "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth",
+     "size_bytes": 67040989, "tier": "optional", "description": "4x 放大(Real-ESRGAN)"},
+]
+_OHOS_DL_TASKS: dict = {}          # task_id -> task dict(内存态; cap 见 _trim)
+_OHOS_DL_LOCK = asyncio.Lock()
+_OHOS_DL_MAX_HISTORY = 100
+
+
+class _OhosDlError(Exception):
+    def __init__(self, code, message):
+        self.code = code
+        self.message = message
+
+
+def _ohos_dl_catalog():
+    mirror = os.environ.get("OHOS_CATALOG_MIRROR", "").strip().rstrip("/")
+    out = []
+    for e in OHOS_DL_CATALOG:
+        e = dict(e)
+        if mirror:
+            e["url"] = mirror + "/" + os.path.basename(e["url"].split("?")[0])
+        out.append(e)
+    return out
+
+
+def _ohos_dl_validate_url(raw_url):
+    u = urllib.parse.urlparse(raw_url)
+    if u.scheme not in ("http", "https"):
+        raise _OhosDlError("INVALID_URL", "scheme must be http/https")
+    host = (u.hostname or "").lower()
+    if host not in OHOS_DL_HOSTS:
+        raise _OhosDlError("INVALID_URL", f"host {host!r} not allowlisted")
+    if not u.path or u.path in ("/", ""):
+        raise _OhosDlError("INVALID_URL", "missing path")
+    return raw_url
+
+
+def _ohos_dl_validate_filename(raw_name, dest_dir):
+    if raw_name != os.path.basename(raw_name) or ".." in raw_name:
+        raise _OhosDlError("INVALID_FILENAME", "basename required, '..' rejected")
+    if len(raw_name) > 128 or not raw_name.lower().endswith(OHOS_DL_SUFFIXES):
+        raise _OhosDlError("INVALID_FILENAME", "name too long or bad suffix")
+    full = os.path.realpath(os.path.join(dest_dir, raw_name))
+    if not folder_paths.is_within_directory(dest_dir, full):
+        raise _OhosDlError("INVALID_FILENAME", "escapes dest dir")
+    return raw_name
+
+
+def _ohos_dl_cleanup_stale(dest_dir, active_ids):
+    # 进程崩溃残留的 .ohosdl-* part(失败/中断未清): 本目录内非活动中任务名全部删除。
+    if not os.path.isdir(dest_dir):
+        return
+    for f in os.listdir(dest_dir):
+        if f.endswith(".part") and ".ohosdl-" in f:
+            tail = f.rsplit(".ohosdl-", 1)[-1].removesuffix(".part")
+            if tail not in active_ids:
+                try:
+                    os.remove(os.path.join(dest_dir, f))
+                except OSError:
+                    pass
+
+
+def _ohos_dl_trim():
+    while len(_OHOS_DL_TASKS) > _OHOS_DL_MAX_HISTORY:
+        oldest = min(_OHOS_DL_TASKS, key=lambda k: _OHOS_DL_TASKS[k].get("created_at", 0))
+        if _OHOS_DL_TASKS[oldest]["status"] not in ("pending", "in_progress", "paused"):
+            _OHOS_DL_TASKS.pop(oldest)
+        else:
+            break
+
+
+class OHOSModelDownloader:
+    """单任务下载器: 流式写 part(目录内隐藏名), 可选 sha 校验, os.replace 原子落盘。
+    状态机与并发控制见 _OHOS_DL_TASKS 与端点闭包; pause 只停读(part 保留),
+    resume 从头重拉(第一版不续传, 文档注明)。"""
+
+    @staticmethod
+    def new_task(url, directory, filename, sha256=None):
+        dest_dir = folder_paths.folder_names_and_paths[directory][0][0]
+        os.makedirs(dest_dir, exist_ok=True)
+        task_id = uuid.uuid4().hex[:16]
+        td = {
+            "task_id": task_id,
+            "url": url,
+            "directory": directory,
+            "filename": filename,
+            "dest_dir": dest_dir,
+            "dest": os.path.join(dest_dir, filename),
+            "part": os.path.join(dest_dir, f".{filename}.ohosdl-{task_id[:8]}.part"),
+            "status": "pending",
+            "bytes_received": 0, "bytes_total": 0, "speed_bps": 0,
+            "error": None,
+            "created_at": time.time(), "updated_at": time.time(),
+            "sha256": (sha256 or "").lower() or None,
+            "_samples": [], "_ts": None,
+        }
+        _ohos_dl_cleanup_stale(dest_dir, set(_OHOS_DL_TASKS) | {task_id})
+        return td
+
+    @staticmethod
+    def task_view(td):
+        t = {k: v for k, v in td.items() if not k.startswith("_")}
+        return t
+
+    # v2(2026-09-05 真机定谳): aiohttp 引擎退场 —— 设备上 aiohttp 请求触发
+    #   asyncio 超时守卫(RuntimeError: Timeout should be used inside a task,
+    #   设备 3.12 stdlib asyncio/timeouts.py, 报错时 bytes=0/5ms 瞬时)——
+    #   下载工作线程化, stdlib urllib 流式; 状态机/字段/清理逻辑与 v1 语义一致。
+    #   同步变更: fetch_externals.sh 证据串仍为 "OHOS_MODEL_DL v1"(见头注释)。
+    @staticmethod
+    def _dl_sync(td):
+        import urllib.request
+        import urllib.error
+        try:
+            req = urllib.request.Request(td["url"], headers={"User-Agent": "comfyui-ohos-w3"})
+            resp = urllib.request.urlopen(req, timeout=120)
+            code = getattr(resp, "status", getattr(resp, "code", 200))
+            if code in (401, 403, 451):
+                raise _OhosDlError(f"HTTP_{code}", "gated or forbidden by source")
+            if code != 200:
+                raise _OhosDlError("NETWORK", f"http {code} from source")
+            td["bytes_total"] = int(resp.headers.get("Content-Length") or 0)
+            h = hashlib.sha256()
+            with open(td["part"], "wb") as f:
+                while True:
+                    if td["status"] == "cancelled":
+                        raise _OhosDlError("CANCELLED", "cancelled")
+                    while td["status"] == "paused":
+                        time.sleep(0.25)
+                        if td["status"] == "cancelled":
+                            raise _OhosDlError("CANCELLED", "cancelled")
+                    chunk = resp.read(64 * 1024)
+                    if not chunk:
+                        break
+                    h.update(chunk)
+                    f.write(chunk)
+                    f.flush()
+                    td["bytes_received"] += len(chunk)
+                    now = time.time()
+                    if td["_ts"] is None or now - td["_ts"] >= 0.5:
+                        td["_samples"].append((now, td["bytes_received"]))
+                        td["_samples"] = td["_samples"][-3:]
+                        td["_ts"] = now
+                        if len(td["_samples"]) >= 2:
+                            (t0, b0), (t1, b1) = td["_samples"][0], td["_samples"][-1]
+                            if t1 > t0:
+                                td["speed_bps"] = int((b1 - b0) / (t1 - t0))
+                        td["updated_at"] = now
+            if td["sha256"] and h.hexdigest() != td["sha256"]:
+                raise _OhosDlError("SHA_MISMATCH", "sha256 mismatch (staging removed)")
+            os.replace(td["part"], td["dest"])
+            td["status"] = "completed"
+            td["bytes_received"] = td["bytes_total"] or td["bytes_received"]
+            td["speed_bps"] = 0
+            td["updated_at"] = time.time()
+        except _OhosDlError as e:
+            td["status"] = "error" if e.code != "CANCELLED" else "cancelled"
+            td["error"] = {"code": e.code, "message": e.message}
+            _ohos_dl_cleanup_stale(td["dest_dir"], set(_OHOS_DL_TASKS) | {td["task_id"]})
+        except urllib.error.HTTPError as e:
+            td["status"] = "error"
+            td["error"] = {"code": "HTTP_" + str(e.code), "message": str(e)}
+        except OSError as e:
+            code = "DISK_FULL" if e.errno == errno.ENOSPC else "NETWORK"
+            td["status"] = "error"
+            td["error"] = {"code": code, "message": str(e)}
+        except Exception as e:
+            # 探针: 根因未明时保留全栈(设备可 curl 任务详情取)
+            td["status"] = "error"
+            td["error"] = {"code": "NETWORK", "message": repr(e), "stack": traceback.format_exc()[:2000]}
+
+    @staticmethod
+    async def run(session, td):
+        td["status"] = "in_progress"
+        td["updated_at"] = time.time()
+        try:
+            if session is None:
+                raise _OhosDlError("BUSY", "server session not ready")
+            await asyncio.get_event_loop().run_in_executor(None, OHOSModelDownloader._dl_sync, td)
+        except _OhosDlError as e:
+            td["status"] = "error" if e.code != "CANCELLED" else "cancelled"
+            td["error"] = {"code": e.code, "message": e.message}
+            _ohos_dl_cleanup_stale(td["dest_dir"], set(_OHOS_DL_TASKS) | {td["task_id"]})
+        except asyncio.CancelledError:
+            td["status"] = "cancelled"
+            raise
+        except Exception as e:
+            td["status"] = "error"
+            td["error"] = {"code": "NETWORK", "message": repr(e), "stack": traceback.format_exc()[:2000]}
+        finally:
+            td["updated_at"] = time.time()
+
